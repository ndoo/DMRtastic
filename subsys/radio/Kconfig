config RADIO_MANAGER
	bool "Handheld-transceiver radio manager"
	default n
	depends on DT_HAS_HT_RADIO_ENABLED
	depends on RADIO_AT1846S
	help
	  Orchestration layer above the RF transceiver and (optionally) DMR
	  baseband drivers. Owns board-level PA/LNA/audio-amp/mic-power
	  GPIOs, applies TX frequency-offset compensation, and drives TX
	  power via the DAC channel described on the ht,radio device tree
	  node.

if RADIO_MANAGER

config RADIO_MANAGER_INIT_PRIORITY
	int "Init priority"
	default 85
	range 50 89

module = RADIO_MANAGER
module-str = radio_mgr
source "subsys/logging/Kconfig.template.log_config"

endif # RADIO_MANAGER
