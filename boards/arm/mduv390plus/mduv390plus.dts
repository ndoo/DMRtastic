/dts-v1/;
#include <st/f4/stm32f405Xg.dtsi>
#include <st/f4/stm32f405vgtx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/display/panel.h>

/* Not yet in this Zephyr version's input-event-codes.h; matches Linux's KEY_NUMERIC_STAR/POUND,
 * guarded in case a future update adds them. */
#ifndef INPUT_KEY_NUMERIC_STAR
#define INPUT_KEY_NUMERIC_STAR  0x20a
#endif
#ifndef INPUT_KEY_NUMERIC_POUND
#define INPUT_KEY_NUMERIC_POUND 0x20b
#endif

/*
 * TYT MD-UV390 PLUS 10W GPS — STM32F405VGT6 (LQFP100)
 */

/ {
	model = "TYT MD-UV390 PLUS 10W GPS";
	compatible = "tyt,mduv390plus", "st,stm32f405";

	chosen {
		zephyr,sram           = &sram0;
		zephyr,flash          = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display        = &hx8353e;
		zephyr,shell-uart     = &cdc_acm_uart0;
	};

	pwr_latch_node: pwr_latch_node {
		compatible = "gpio-leds";
		pwr_latch: pwr_latch {
			gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
		};
	};

	leds {
		compatible = "gpio-leds";
		led_green: led_green {
			gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>;
		};
		led_red: led_red {
			gpios = <&gpioe 1 GPIO_ACTIVE_HIGH>;
		};
	};

	/* col-gpios (driven) and row-gpios (sensed) are the same 8 pins as lcd_mipi_dbi's data-gpios below;
	 * kbd_matrix_shared_bus borrows them per scan (see that driver). Active-high, no pull -- a pull-up would source current onto the shared LCD lines. */
	keypad: keypad {
		compatible = "gpio-kbd-matrix-shared-bus";
		col-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>,
		            <&gpiod 2 GPIO_ACTIVE_HIGH>,
		            <&gpiod 3 GPIO_ACTIVE_HIGH>;
		row-gpios = <&gpiod 14 GPIO_ACTIVE_HIGH>,
		            <&gpiod 15 GPIO_ACTIVE_HIGH>,
		            <&gpiod  0 GPIO_ACTIVE_HIGH>,
		            <&gpiod  1 GPIO_ACTIVE_HIGH>,
		            <&gpioe  7 GPIO_ACTIVE_HIGH>,
		            <&gpioe  8 GPIO_ACTIVE_HIGH>,
		            <&gpioe  9 GPIO_ACTIVE_HIGH>,
		            <&gpioe 10 GPIO_ACTIVE_HIGH>;

		/* row/col below are input-keymap's own axes (INPUT_ABS_Y/X), not physical row/col: "row" (0-7) =
		 * sensed/physical-column, "col" (0-2) = driven/physical-row -- confirmed against real hardware labels. */
		keymap {
			compatible = "input-keymap";
			row-size = <8>;
			col-size = <3>;
			keymap = <
				MATRIX_KEY(0, 0, INPUT_KEY_1)
				MATRIX_KEY(1, 0, INPUT_KEY_2)
				MATRIX_KEY(2, 0, INPUT_KEY_3)
				MATRIX_KEY(3, 0, INPUT_KEY_4)
				MATRIX_KEY(4, 0, INPUT_KEY_5)
				MATRIX_KEY(5, 0, INPUT_KEY_6)
				MATRIX_KEY(6, 0, INPUT_KEY_0)
				MATRIX_KEY(7, 0, INPUT_KEY_NUMERIC_STAR)

				MATRIX_KEY(0, 1, INPUT_KEY_ENTER)
				MATRIX_KEY(1, 1, INPUT_KEY_UP)
				MATRIX_KEY(2, 1, INPUT_KEY_DOWN)
				MATRIX_KEY(3, 1, INPUT_KEY_7)
				MATRIX_KEY(4, 1, INPUT_KEY_8)
				MATRIX_KEY(5, 1, INPUT_KEY_9)
				MATRIX_KEY(6, 1, INPUT_KEY_NUMERIC_POUND)
				MATRIX_KEY(7, 1, INPUT_KEY_BACK)

				/* col 2 (D_2/PD3): only S_6/S_7 wired — SK2/SK1 */
				MATRIX_KEY(6, 2, INPUT_KEY_F16)
				MATRIX_KEY(7, 2, INPUT_KEY_F15)
			>;
		};
	};

	ptt_buttons: ptt_buttons {
		compatible = "gpio-keys";
		/* PE11 shares an EXTI line with the encoder's PB11 -- poll here so
		 * the encoder gets the interrupt; PTT tolerates the latency. */
		polling-mode;
		ptt: ptt {
			gpios = <&gpioe 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_F13>;
		};
		ptt_external: ptt_external {
			gpios = <&gpioe 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_F14>;
		};
	};

	rotary_encoder: rotary_encoder {
		compatible = "gpio-qdec";
		gpios = <&gpioe 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
		        <&gpiob 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* Real per-detent count is 2 edges (not 1 -- single clicks double-
		 * stepped; not 4 -- single clicks were often dropped entirely). */
		steps-per-period = <2>;
		/* Fast enough to not miss a quadrature edge on a quick flick. */
		sample-time-us = <250>;
		idle-timeout-ms = <200>;
		/* No idle-poll-time-us: PTT (above) polls now, freeing this EXTI
		 * line so the encoder can idle on a real GPIO interrupt instead. */
		zephyr,axis = <INPUT_REL_Y>;
	};

	lvgl_encoder: lvgl-encoder-input {
		compatible = "zephyr,lvgl-encoder-input";
		rotation-input-code = <INPUT_REL_Y>;
	};

	vol_axis: vol_axis {
		compatible = "analog-axis";
		poll-period-ms = <50>;
		axis-volume {
			io-channels = <&adc1 0>;
			in-min  = <24>;
			in-max  = <2025>;
			out-min = <0>;
			out-max = <100>;
			zephyr,axis = <INPUT_ABS_THROTTLE>;
		};
	};

	lcd_mipi_dbi: lcd_mipi_dbi {
		compatible = "zephyr,mipi-dbi-bitbang";
		status = "okay";
		dc-gpios    = <&gpiod 12 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpiod 13 GPIO_ACTIVE_LOW>;
		/* WR is physically active-LOW (8080 write strobe); GPIO_ACTIVE_HIGH is correct here since
		 * gpio_pin_set_dt(wr, 1) drives HIGH (latch) and (wr, 0) drives LOW (assert) -- ACTIVE_LOW would invert this and prevent any latch. */
		wr-gpios    = <&gpiod  5 GPIO_ACTIVE_HIGH>;
		rd-gpios    = <&gpiod  4 GPIO_ACTIVE_HIGH>;
		cs-gpios    = <&gpiod  6 GPIO_ACTIVE_LOW>;
		data-gpios  = <&gpiod 14 GPIO_ACTIVE_HIGH>,
		              <&gpiod 15 GPIO_ACTIVE_HIGH>,
		              <&gpiod  0 GPIO_ACTIVE_HIGH>,
		              <&gpiod  1 GPIO_ACTIVE_HIGH>,
		              <&gpioe  7 GPIO_ACTIVE_HIGH>,
		              <&gpioe  8 GPIO_ACTIVE_HIGH>,
		              <&gpioe  9 GPIO_ACTIVE_HIGH>,
		              <&gpioe 10 GPIO_ACTIVE_HIGH>;
		#address-cells = <1>;
		#size-cells    = <0>;

		hx8353e: hx8353e@0 {
			compatible = "himax,hx8353e";
			reg = <0>;
			mipi-max-frequency = <15000000>;
			mipi-mode = "MIPI_DBI_MODE_8080_BUS_8_BIT";
			width    = <160>;
			height   = <128>;
			rotation = <90>;
			backlight-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
		};
	};

	hr_c6000_spi: spi {
		/* IRQ-safe SPI: the HR-C6000 driver issues spi_transceive() from interrupt context (DMR timeslot state
		 * machine), but upstream zephyr,spi-bitbang acquires a k_sem and isn't ISR-callable; this uses k_spinlock_t instead. */
		compatible = "ht-radio,spi-bitbang-irq";
		status = "okay";
		#address-cells = <1>;
		#size-cells    = <0>;
		clk-gpios  = <&gpioe 3 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpioe 4 GPIO_ACTIVE_HIGH>;
		miso-gpios = <&gpioe 5 GPIO_ACTIVE_HIGH>;
		cs-gpios   = <&gpioe 2 GPIO_ACTIVE_LOW>;

		hr_c6000: hr_c6000@0 {
			compatible = "hongrui,hr-c6000";
			reg = <0>;
			spi-max-frequency = <1000000>;
			power-down-gpios   = <&gpioe 6 GPIO_ACTIVE_LOW>;
			/* Three HR-C6000 interrupt outputs; edge type (rising) is set at runtime via
			 * gpio_pin_interrupt_configure_dt() -- only active-level polarity belongs in these DT cell flags. */
			timeslot-int-gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>;
			sys-int-gpios      = <&gpioc 1 GPIO_ACTIVE_HIGH>;
			rftx-int-gpios     = <&gpioc 2 GPIO_ACTIVE_HIGH>;
		};
	};

	radio_io: radio_io {
		compatible = "gpio-leds";
		pa_en2:  pa_en2  { gpios = <&gpioc  4 GPIO_ACTIVE_HIGH>; };
		pa_en1:  pa_en1  { gpios = <&gpioc  5 GPIO_ACTIVE_HIGH>; };
		pa_sel:  pa_sel  { gpios = <&gpiod  8 GPIO_ACTIVE_HIGH>; };
		ctc_dcs: ctc_dcs { gpios = <&gpioc  7 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>; };
		beep:    beep    { gpios = <&gpioc  8 GPIO_ACTIVE_HIGH>; };
		mic_pwr: mic_pwr { gpios = <&gpioa 13 GPIO_ACTIVE_HIGH>; };
	};

	aliases {
		led0       = &led_green;
		led1       = &led_red;
		watchdog0  = &iwdg;
	};
};

&clk_hse {
	hse-bypass;
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&clk_lse {
	status = "okay";
};

&pll {
	div-m = <4>;
	mul-n = <72>;
	div-p = <2>;
	div-q = <3>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(72)>;
	ahb-prescaler  = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB1, 28)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
	backup_regs {
		status = "okay";
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		bootloader_partition: partition@0 {
			label = "tyt-bootloader";
			reg = <0x00000000 DT_SIZE_K(48)>;
			read-only;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000C000 (DT_SIZE_K(1024) - DT_SIZE_K(48))>;
		};
	};
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11_hs &usb_otg_fs_dp_pa12_hs>;
	pinctrl-names = "default";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		hw-flow-control;
	};
};

&pinctrl {
	i2c3_scl_pa8_hs: i2c3_scl_pa8_hs {
		pinmux = <STM32_PINMUX('A', 8, AF4)>;
		drive-open-drain;
		slew-rate = "very-high-speed";
	};
	i2c3_sda_pc9_hs: i2c3_sda_pc9_hs {
		pinmux = <STM32_PINMUX('C', 9, AF4)>;
		drive-open-drain;
		slew-rate = "very-high-speed";
	};
	/* I2S3ext full-duplex RX — AF5, not AF6 (SPI3_MISO) */
	i2s3_ext_sd_pc11: i2s3_ext_sd_pc11 {
		pinmux = <STM32_PINMUX('C', 11, AF5)>;
	};
	/* USB OTG FS — very-high-speed required per STM32F405 RM. */
	usb_otg_fs_dm_pa11_hs: usb_otg_fs_dm_pa11_hs {
		pinmux = <STM32_PINMUX('A', 11, AF10)>;
		slew-rate = "very-high-speed";
	};
	usb_otg_fs_dp_pa12_hs: usb_otg_fs_dp_pa12_hs {
		pinmux = <STM32_PINMUX('A', 12, AF10)>;
		slew-rate = "very-high-speed";
	};
};

&i2c3 {
	pinctrl-0 = <&i2c3_scl_pa8_hs &i2c3_sda_pc9_hs>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	scl-gpios = <&gpioa 8 GPIO_OPEN_DRAIN>;
	sda-gpios = <&gpioc 9 GPIO_OPEN_DRAIN>;
	status = "okay";

	at1846s: at1846s@2e {
		compatible = "auctus,at1846s";
		reg = <0x2e>;
		freq-ranges = <134000000 174000000  400000000 520000000>;
		band-select-gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>,
		                    <&gpioa 2 GPIO_ACTIVE_HIGH>;
		rx-audio-mux-gpios = <&gpiod 9 GPIO_ACTIVE_HIGH>;
		amp-en-gpios       = <&gpiob 9 GPIO_ACTIVE_HIGH>;
		spk-mute-gpios     = <&gpiob 8 GPIO_ACTIVE_HIGH>;
		tx-freq-offset-hz = <0>;
		squelch-mode = "software";
	};
};

&adc1 {
	pinctrl-0 = <&adc1_in0_pa0 &adc1_in1_pa1 &adc1_in3_pa3>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	st,adc-prescaler = <8>; /* PCLK2/8 = 9 MHz */
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain            = "ADC_GAIN_1";
		zephyr,reference       = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 480)>;
		zephyr,resolution      = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain            = "ADC_GAIN_1";
		zephyr,reference       = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 480)>;
		zephyr,resolution      = <12>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain            = "ADC_GAIN_1";
		zephyr,reference       = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 480)>;
		zephyr,resolution      = <12>;
	};

	/* Internal temperature sensor — channel 16 on STM32F4 */
	channel@10 {
		reg = <16>;
		zephyr,gain            = "ADC_GAIN_1";
		zephyr,reference       = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 480)>;
		zephyr,resolution      = <12>;
		zephyr,vref-mv         = <1210>;
	};
};

&dac1 {
	pinctrl-0 = <&dac_out1_pa4>;
	pinctrl-names = "default";
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pb3 &spi1_miso_pb4 &spi1_mosi_pb5>;
	pinctrl-names = "default";
	cs-gpios = <&gpiod 7 GPIO_ACTIVE_LOW>;
	status = "okay";

	/* Codeplug flash — SPI Mode 0, 128 Mbit. SFDP_RUNTIME discovers all params at boot. */
	w25q_codeplug: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <4500000>; /* 72 MHz / 16 */
	};
};

&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	/* Voice flash — SPI Mode 2 (CPOL=1/CPHA=0). SFDP_RUNTIME discovers params at boot. */
	w25q_voice: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <4500000>;
		spi-cpol;
	};
};

&i2s3 {
	pinctrl-0 = <&i2s3_ws_pa15 &i2s3_ck_pc10 &i2s3_sd_pc12 &i2s3_ext_sd_pc11>;
	pinctrl-names = "default";
	status = "okay";
};

&iwdg {
	status = "okay";
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};
