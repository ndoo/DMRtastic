config SIM_PWM
	bool "Simulated PWM controller"
	default y
	depends on DT_HAS_DMRTASTIC_SIM_PWM_ENABLED

config SIM_AT1846S
	bool "Simulated AT1846S transceiver"
	default y
	depends on DT_HAS_DMRTASTIC_SIM_AT1846S_ENABLED

config SIM_HR_C6000
	bool "Simulated HR-C6000 baseband"
	default y
	depends on DT_HAS_DMRTASTIC_SIM_HR_C6000_ENABLED

config SIM_FLASH
	bool "Simulated SPI NOR flash"
	default y
	depends on DT_HAS_DMRTASTIC_SIM_SPI_NOR_ENABLED
	select FLASH_JESD216

config SIM_WDT
	bool "Simulated watchdog"
	default y
	depends on DT_HAS_DMRTASTIC_SIM_WDT_ENABLED

config SIM_GPIO
	bool "Simulated GPIO ports"
	default y
	depends on DT_HAS_DMRTASTIC_SIM_GPIO_ENABLED
	depends on GPIO

config SIM_LCD
	bool "HX8353E controller model"
	default y

config SIM_LCD_WIRE
	bool "Decode the GPIO-driven LCD bus"
	default y
	depends on SIM_GPIO && SIM_LCD
	depends on DT_HAS_ZEPHYR_MIPI_DBI_BITBANG_ENABLED

config SIM_INPUT
	bool "Keypad, PTT, encoder, volume and battery models"
	default y
	depends on SIM_GPIO && ADC_EMUL

config SIM_GPS
	bool "GPS module model"
	default y
	depends on SIM_GPIO && UART_EMUL

config SIM_CDC_UART
	bool "Console UART standing in for USB CDC ACM"
	default y
	depends on DT_HAS_ZEPHYR_CDC_ACM_UART_ENABLED && !USBD_CDC_ACM_CLASS
	depends on SERIAL

config SIM_MIPI_DBI
	bool "API-level MIPI DBI model"
	default y
	depends on SIM_LCD
	depends on DT_HAS_DMRTASTIC_SIM_MIPI_DBI_ENABLED
