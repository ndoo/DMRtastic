FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake device-tree-compiler file git \
        gdb gperf libsdl2-dev ninja-build patch pkg-config python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    ZEPHYR_TOOLCHAIN_VARIANT=host \
    ZEPHYR_BASE=/ws/zephyr
RUN pip install --no-cache-dir west

WORKDIR /ws/app
